# Sao chép thành client/.env. Không commit client/.env.
# CẢNH BÁO: biến có tiền tố VITE_ được đóng gói vào mã trình duyệt, ai cũng đọc được.
# Không đặt khóa, token hoặc mật khẩu ở đây. Bí mật chỉ đặt trong server/.env.

# Địa chỉ máy chủ mà Vite chuyển tiếp /api và /health tới (chỉ dùng khi phát triển).
API_PROXY_TARGET=http://localhost:4000

# Địa chỉ gốc của API khi giao diện và máy chủ ở hai tên miền khác nhau (production).
# Để trống khi phát triển (Vite proxy) hoặc khi máy chủ phục vụ luôn bản build giao diện.
# Production trên Vercel: đặt VITE_API_BASE_URL=https://flowy.api.vientruong.site rồi build lại.
VITE_API_BASE_URL=

# Đặt "true" nếu thay đổi file không được nhận (ví dụ chạy trong Docker trên Windows).
VITE_USE_POLLING=false

# Mô-đun nghiệp vụ dùng API thật, phân cách bằng dấu phẩy. Ví dụ: auth,assistant,finance,orders,alerts.
# Xác thực luôn dùng máy chủ; các mô-đun chưa liệt kê tiếp tục dùng dữ liệu mẫu.
VITE_REAL_API=
