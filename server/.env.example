# Sao chép thành server/.env rồi điền giá trị thật. Không commit server/.env.
# File này nằm trong repo công khai: chỉ ghi tên biến, giá trị mẫu hoặc để trống.

# --- Máy chủ ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Các origin trình duyệt được gọi API, phân cách bằng dấu phẩy.
# Production: CORS_ORIGIN=https://flowy.vientruong.site
CORS_ORIGIN=http://localhost:5173
# Chỉ đặt khi server phục vụ bản build client, ví dụ /app/public trong Docker.
SERVE_CLIENT_DIR=

# --- Cơ sở dữ liệu (giá trị mẫu cho Postgres chạy trên máy) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sales_assistant

# --- Đăng nhập ---
# Tối thiểu 8 ký tự. Khi NODE_ENV=production: tối thiểu 32 ký tự và không được là giá trị mẫu.
# Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Tài khoản demo cho giám khảo; để trống nếu không dùng.
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Meta Messenger ---
FB_APP_SECRET=
FB_VERIFY_TOKEN=any-random-string
FB_PAGE_ACCESS_TOKEN=
# Kiểm tra phiên bản hiện hành trong App Dashboard
GRAPH_API_VERSION=v23.0

# --- SePay ---
SEPAY_WEBHOOK_API_KEY=
# Khóa cho webhook giả lập (mã chưa đọc biến này).
SIM_WEBHOOK_SECRET=

# --- Nhà cung cấp AI (chat completions tương thích OpenAI; đội dùng OpenRouter) ---
# Để trống AI_API_KEY hoặc AI_MODEL thì AI tắt, các tính năng chạy bằng chế độ luật.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Model mặc định, dạng id của OpenRouter, ví dụ <nhà-cung-cấp>/<tên-model>.
AI_MODEL=
# Model riêng cho từng vai trò; để trống thì dùng AI_MODEL.
# Agent và bot cần model hỗ trợ tools; vision cần model đọc được ảnh.
AI_MODEL_AGENT=
AI_MODEL_BOT=
AI_MODEL_CLASSIFY=
AI_MODEL_VISION=
AI_MODEL_FRAUD=
# true: dùng AI giả lập, không gọi nhà cung cấp (chạy thử không cần khóa).
AI_MOCK=false
# Số lượt agent tối đa mỗi shop mỗi ngày.
# Giới hạn mỗi cửa hàng mỗi ngày; lưu trong bộ nhớ và đặt lại khi máy chủ khởi động.
AI_DAILY_RUN_LIMIT=50
# Thời gian chờ mỗi lần gọi model (ms).
AI_TIMEOUT_MS=30000

# --- Tài khoản nhận tiền (VietQR) ---
BANK_CODE=MB
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
